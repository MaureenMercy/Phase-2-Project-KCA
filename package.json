{
  "name": "saku-election-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "api": "tsx server/index.ts",
    "dev:stack": "concurrently -n api,web -c yellow,blue \"npm run api\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "start:stack": "concurrently -n api,web -c yellow,blue \"npm run api\" \"next start\"",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.4",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
